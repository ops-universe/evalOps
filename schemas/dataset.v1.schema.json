{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evalOps dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "synthetic",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric",
          "expected",
          "actual"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "metric": {
            "enum": [
              "exact",
              "contains"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "actual": {
            "type": "string",
            "maxLength": 100000
          }
        }
      }
    }
  }
}
