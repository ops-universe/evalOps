{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent evaluation dataset v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "synthetic",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "allowedTools",
          "expected",
          "actual",
          "expectedCompleted",
          "actualCompleted"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "allowedTools": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "expected": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/call"
            }
          },
          "actual": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/call"
            }
          },
          "expectedCompleted": {
            "type": "boolean"
          },
          "actualCompleted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "call": {
      "type": "object",
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/id"
        },
        "args": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
