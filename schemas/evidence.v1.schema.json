{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evalOps evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceVersion",
    "evaluatorVersion",
    "datasetSha256",
    "synthetic",
    "schemaVersion",
    "total",
    "passed",
    "failed",
    "passRate",
    "minPassRate",
    "gate",
    "results"
  ],
  "properties": {
    "evidenceVersion": {
      "const": 1
    },
    "evaluatorVersion": {
      "type": "string"
    },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "schemaVersion": {
      "const": 1
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "passRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minPassRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gate": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric",
          "passed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "metric": {
            "enum": [
              "exact",
              "contains",
              "normalized-exact",
              "json-equal"
            ]
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "suiteSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
